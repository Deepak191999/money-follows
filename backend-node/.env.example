# All of these have working defaults; nothing here is required to run locally.

# log    - print invitation emails to the server console (default)
# outbox - store them in the dev_outbox table, readable at GET /dev/outbox.
#          Use this to demo the invite flow with no mail credentials.
# smtp   - a real mail provider. Not implemented: it throws at send time rather
#          than silently dropping invitations.
MAIL_TRANSPORT=outbox

# Base URL used to build invitation links (the frontend, not the API).
APP_URL=http://localhost:5173

# How long an invitation link stays valid.
INVITE_TTL_DAYS=7
